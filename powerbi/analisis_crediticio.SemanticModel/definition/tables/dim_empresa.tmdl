table dim_empresa
	lineageTag: c855eafe-105a-5304-89e3-0ac639a5d9ed

	column empresa
		dataType: string
		lineageTag: b89d9a81-6861-56f1-86ca-dc925721bf6a
		summarizeBy: none
		sourceColumn: empresa
		sortByColumn: orden

		annotation SummarizationSetBy = Automatic

	column orden
		dataType: int64
		lineageTag: cc3bdc8d-1af7-57e9-92fd-6ab1cb36d56d
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = Automatic

	partition dim_empresa = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\outputs\empresas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado = Table.TransformColumnTypes(Encabezados, {{"empresa", type text}, {"orden", Int64.Type}}, "en-US")
				in
				    Resultado
