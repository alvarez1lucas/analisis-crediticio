	partition puente = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\outputs\puente.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Resultado = Table.TransformColumnTypes(Encabezados, {{"empresa", type text}, {"anio", Int64.Type}, {"orden", Int64.Type}, {"concepto", type text}, {"monto", type number}}, "en-US")
				in
				    Resultado
