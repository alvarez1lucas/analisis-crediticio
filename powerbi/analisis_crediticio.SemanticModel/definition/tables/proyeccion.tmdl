	partition proyeccion = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\outputs\proyeccion.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Paso0 = Table.TransformColumnTypes(Encabezados, {{"empresa", type text}, {"escenario", type text}, {"anio", Int64.Type}, {"indicador", type text}, {"valor", type number}}, "en-US"),
				    Resultado = Paso0
				in
				    Resultado
