	partition tendencias = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\outputs\tendencias.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
