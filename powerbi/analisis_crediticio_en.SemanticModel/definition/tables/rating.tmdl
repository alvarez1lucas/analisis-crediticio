	partition rating = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\outputs\rating.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
