	partition colocadores_entidad = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\outputs\colocadores_entidad.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Paso0 = Table.TransformColumnTypes(Encabezados, {{"entidad", type text}, {"tipo_entidad", type text}, {"emisiones", Int64.Type}, {"como_organizador", Int64.Type}, {"monto_emisiones", type number}, {"empresas", type text}}, "en-US"),
				    Paso1 = Table.ReplaceValue(Paso0, "Banco", "Bank", Replacer.ReplaceValue, {"tipo_entidad"}),
				    Paso2 = Table.ReplaceValue(Paso1, "ALyC", "Broker-dealer", Replacer.ReplaceValue, {"tipo_entidad"}),
				    Paso3 = Table.ReplaceValue(Paso2, "ALyC de un banco", "Bank-owned broker", Replacer.ReplaceValue, {"tipo_entidad"}),
				    Paso4 = Table.ReplaceValue(Paso3, "Plataforma digital", "Digital platform", Replacer.ReplaceValue, {"tipo_entidad"}),
				    Paso5 = Table.ReplaceValue(Paso4, "Banco de inversión del exterior", "Foreign investment bank", Replacer.ReplaceValue, {"tipo_entidad"}),
				    Resultado = Paso5
				in
				    Resultado
