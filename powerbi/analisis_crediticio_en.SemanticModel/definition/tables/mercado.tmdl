	partition mercado = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "\data\mercado.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Paso0 = Table.TransformColumnTypes(Encabezados, {{"fecha", type date}, {"riesgo_pais", type number}, {"ust_1", type number}, {"ust_2", type number}, {"ust_3", type number}, {"ust_5", type number}, {"ust_7", type number}, {"ust_10", type number}, {"badlar", type number}, {"adelantos", type number}}, "en-US"),
				    Resultado = Paso0
				in
				    Resultado
